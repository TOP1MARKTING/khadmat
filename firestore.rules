rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for the knowledge site
    match /{document=**} {
      allow read: if true;
    }

    // Writes: signed-in admin only (create user in Firebase Authentication)
    match /services/{id} {
      allow write: if request.auth != null;
    }
    match /articles/{id} {
      allow write: if request.auth != null;
    }
    match /categories/{id} {
      allow write: if request.auth != null;
    }
    match /cities/{id} {
      allow write: if request.auth != null;
    }
    match /digitalAssets/{id} {
      allow write: if request.auth != null;
    }
    match /mediaLibrary/{id} {
      allow write: if request.auth != null;
    }
    match /settings/{id} {
      allow write: if request.auth != null;
    }
    match /meta/{id} {
      allow write: if request.auth != null;
    }
  }
}
